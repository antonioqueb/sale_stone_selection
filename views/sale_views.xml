<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_stone_selection" model="ir.ui.view">
        <field name="name">sale.order.form.stone.selection</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Autosave del formulario de la orden de venta -->
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">stone_autosave_form</attribute>
            </xpath>

            <!-- Sin banderines de estado en el encabezado: el estado ya se
                 lee en la lista y en los botones disponibles. -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Cancelar sale de la botonera: vive en el engrane (ver la
                 acción de servidor al final de este archivo). -->
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- js_class para cargar assets -->
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="js_class">stone_order_line_list</attribute>
            </xpath>

            <!--
                Clase contenedora para ACOTAR estilos a estas líneas:
                quita el fondo gris de la fila seleccionada/editada (o_selected_row),
                en hover y al enfocar una celda, SIN afectar otras listas de Odoo.
                Se añade con 'add' para no pisar clases existentes del campo.
                Estilos en static/src/scss/stone_styles.scss (.o_tc_clean_order_lines).
            -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="class" add="o_tc_clean_order_lines" separator=" "/>
                <!-- SIN montos por sección en la interfaz: las secciones son
                     DIVISORES, no subtotales — los montos por sección
                     confundían a los vendedores. -->
                <attribute name="aggregated_fields"></attribute>
            </xpath>

            <!-- Botones de captura garantizados (en español) -->
            <!-- OJO: el control se reemplaza COMPLETO — debe conservar el
                 botón de catálogo del core porque otras herencias
                 (stock_transit_allocation) lo anclan por xpath. -->
            <xpath expr="//field[@name='order_line']/list/control" position="replace">
                <control>
                    <create name="add_product_control" string="Agregar producto"/>
                    <create name="add_section_control" string="Agregar sección" context="{'default_display_type': 'line_section'}"/>
                    <create name="add_note_control" string="Agregar nota" context="{'default_display_type': 'line_note'}"/>
                    <button string="Catálogo"
                            name="action_add_from_catalog"
                            type="object"
                            class="px-4 btn-link"
                            context="{'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Botón Stone ANTES del producto (izquierda) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="is_stone_expanded"
                       widget="stone_expand_button"
                       string=" "
                       width="30px"
                       nolabel="1"
                       column_invisible="parent.state != 'sale'"
                       class="p-0 text-center"/>
            </xpath>

            <!--
                Campos ocultos necesarios para el widget:
                - state: permite saber si la línea ya pertenece a una OV confirmada.
                - lot_ids / x_lot_breakdown_json: selección real de stock.
            -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="state" column_invisible="True"/>
                <field name="lot_ids" column_invisible="True"/>
                <field name="x_lot_breakdown_json" column_invisible="True"/>
            </xpath>

            <!--
                Columna Descripción (campo name): existe en la lista pero Odoo la entrega
                como columna opcional oculta. La marcamos como opcional VISIBLE por defecto:
                aparece de entrada y el usuario puede ocultarla desde el selector de columnas.
            -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

        </field>
    </record>

    <!-- Cancelar desde el engrane (menú Acciones) del formulario: reemplaza
         al botón oculto de la botonera. records.action_cancel() conserva el
         flujo nativo (wizard de cancelación cuando aplica). -->
    <record id="action_server_sale_order_cancel" model="ir.actions.server">
        <field name="name">Cancelar orden</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">result = records.action_cancel()
# action_cancel() sólo devuelve una acción cuando toca abrir el wizard de
# cancelación; en el caso normal cancela y devuelve True. Asignar ese True a
# "action" truena en clean_action ('bool' object has no attribute 'setdefault').
if result and result is not True:
    action = result</field>
    </record>
</odoo>