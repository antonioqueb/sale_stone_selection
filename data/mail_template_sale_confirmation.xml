<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Correo de confirmación de venta con el branding SOM (HTML/CSS
         email-safe, logo, azul de la casa) y copy en inglés pulido.
         Sobrescribe el body del template nativo en cada -u. -->
    <record id="sale.mail_template_sale_confirmation" model="mail.template">
        <field name="subject">Your order {{ object.name or 'n/a' }} is confirmed — SOM Sophisticated Materials</field>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 24px 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #000000;">
        <!-- HEADER -->
        <tr>
            <td style="padding: 26px 32px 18px; text-align: center; border-bottom: 2px solid #000000;">
                <img t-att-src="object.get_base_url() + '/theme_list_modern/static/img/logosom.png'"
                     alt="SOM Sophisticated Materials"
                     style="height: 44px; width: auto;"/>
            </td>
        </tr>
        <!-- TITLE -->
        <tr>
            <td style="padding: 30px 32px 6px; text-align: center;">
                <t t-set="tx_sudo" t-value="object.get_portal_last_transaction()"/>
                <t t-if="object.state == 'sale' or (tx_sudo and tx_sudo.state in ('done', 'authorized'))">
                    <div style="font-size: 13px; letter-spacing: .14em; font-weight: 600; color: #000000; text-transform: uppercase;">Order confirmed</div>
                    <div style="font-size: 26px; font-weight: 800; color: #000000; margin-top: 6px;">Thank you for choosing SOM</div>
                </t>
                <t t-elif="tx_sudo and tx_sudo.state == 'pending'">
                    <div style="font-size: 13px; letter-spacing: .14em; font-weight: 600; color: #000000; text-transform: uppercase;">Order pending payment</div>
                    <div style="font-size: 26px; font-weight: 800; color: #000000; margin-top: 6px;">We are almost there</div>
                </t>
            </td>
        </tr>
        <!-- BODY COPY -->
        <tr>
            <td style="padding: 14px 40px 8px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Dear <b t-out="object.partner_id.name or ''">Customer</b>,
                </p>
                <t t-if="object.state == 'sale' or (tx_sudo and tx_sudo.state in ('done', 'authorized'))">
                    <p style="margin: 0 0 12px;">
                        We are delighted to confirm your order
                        <b t-out="object.name or ''">S00049</b>. Our team has
                        already begun preparing your material with the care each
                        natural piece deserves.
                    </p>
                </t>
                <t t-elif="tx_sudo and tx_sudo.state == 'pending'">
                    <p style="margin: 0 0 12px;">
                        Your order <b t-out="object.name or ''">S00049</b> has been
                        received and will be confirmed as soon as your payment is
                        processed.
                        <t t-if="object.reference">
                            Your payment reference is <b t-out="object.reference or ''"/>.
                        </t>
                    </p>
                </t>
            </td>
        </tr>
        <!-- ORDER CARD -->
        <tr>
            <td style="padding: 6px 40px 10px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #000000;">
                    <tr>
                        <td style="padding: 18px 22px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13px; color: #1a1a1a;">
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Order</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="object.name or ''">S00049</td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Total amount</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 800; font-size: 16px; color: #000000;"
                                        t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</td>
                                </tr>
                                <tr t-if="object.user_id">
                                    <td style="padding: 4px 0; color: #555555;">Your sales advisor</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="object.user_id.name or ''">Advisor</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <!-- DOCUMENTS -->
        <tr>
            <td style="padding: 0 40px 8px; font-size: 13px; color: #1a1a1a; line-height: 1.6;">
                <t t-set="documents" t-value="object._get_product_documents()"/>
                <t t-if="documents">
                    <p style="margin: 10px 0 6px; font-weight: 700; color: #000000;">
                        Documents you may find useful:
                    </p>
                    <ul style="margin: 0 0 8px; padding-left: 18px;">
                        <t t-foreach="documents" t-as="document">
                            <li style="margin: 2px 0;">
                                <a style="color: #000000; text-decoration: underline; font-weight: 600;"
                                   t-out="document.ir_attachment_id.name"
                                   t-att-href="object.get_portal_url('/document/' + str(document.id))"
                                   t-att-target="target"/>
                            </li>
                        </t>
                    </ul>
                </t>
            </td>
        </tr>
        <!-- CLOSING -->
        <tr>
            <td style="padding: 4px 40px 26px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Every slab of natural stone is one of a kind — thank you for
                    trusting us with yours. If you have any questions, simply
                    reply to this email and your advisor will take care of you.
                </p>
                <p style="margin: 0;">
                    Warm regards,<br/>
                    <b t-out="object.user_id.name or object.company_id.name or ''">OLGA ELIZONDO</b><br/>
                    <span style="color: #555555;" t-out="object.company_id.name or ''">SOM Group</span>
                </p>
            </td>
        </tr>
        <!-- FOOTER -->
        <tr>
            <td style="padding: 16px 32px; background: #000000; text-align: center; border-top: 1px solid #000000;">
                <div style="font-size: 11px; color: #cccccc; letter-spacing: .12em; text-transform: uppercase;">
                    <span t-out="object.company_id.name or 'SOM Group'">SOM Group</span>
                    <t t-if="object.company_id.phone"> · <span t-out="object.company_id.phone"/></t>
                    <t t-if="object.company_id.email"> · <span t-out="object.company_id.email"/></t>
                </div>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

    <!-- Cotización enviada: mismo lenguaje blanco y negro formal -->
    <record id="sale.email_template_edi_sale" model="mail.template">
        <field name="subject">Your {{ object.state in ('draft', 'sent') and 'quotation' or 'order' }} {{ object.name or 'n/a' }} — SOM Sophisticated Materials</field>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 24px 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%%" cellpadding="0" cellspacing="0" style="max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #000000;">
        <tr>
            <td style="padding: 26px 32px 18px; text-align: center; border-bottom: 2px solid #000000;">
                <img t-att-src="object.get_base_url() + '/theme_list_modern/static/img/logosom.png'"
                     alt="SOM Sophisticated Materials"
                     style="height: 44px; width: auto;"/>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px 32px 6px; text-align: center;">
                <t t-set="doc_name" t-value="'Quotation' if object.state in ('draft', 'sent') else 'Order'"/>
                <div style="font-size: 13px; letter-spacing: .14em; font-weight: 600; color: #000000; text-transform: uppercase;">Your <t t-out="doc_name"/> is ready</div>
                <div style="font-size: 26px; font-weight: 800; color: #000000; margin-top: 6px;">Prepared exclusively for you</div>
            </td>
        </tr>
        <tr>
            <td style="padding: 14px 40px 8px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Dear <b t-out="object.partner_id.name or ''">Customer</b>,
                </p>
                <p style="margin: 0 0 12px;">
                    Please find attached your <t t-out="doc_name.lower()"/>
                    <b t-out="object.name or ''">S00049</b><t t-if="object.origin"> (reference <t t-out="object.origin"/>)</t>,
                    carefully prepared by our team. We selected each material with
                    the standard of quality that defines SOM.
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 6px 40px 10px;">
                <table role="presentation" width="100%%" cellpadding="0" cellspacing="0" style="border: 1px solid #000000;">
                    <tr>
                        <td style="padding: 18px 22px;">
                            <table role="presentation" width="100%%" cellpadding="0" cellspacing="0" style="font-size: 13px; color: #1a1a1a;">
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Document</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="object.name or ''">S00049</td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Total amount</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 800; font-size: 16px; color: #000000;"
                                        t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</td>
                                </tr>
                                <tr t-if="object.validity_date">
                                    <td style="padding: 4px 0; color: #555555;">Valid until</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="format_date(object.validity_date) or ''"/>
                                </tr>
                                <tr t-if="object.user_id">
                                    <td style="padding: 4px 0; color: #555555;">Your sales advisor</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="object.user_id.name or ''">Advisor</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding: 0 40px 8px; font-size: 13px; color: #1a1a1a; line-height: 1.6;">
                <t t-set="documents" t-value="object._get_product_documents()"/>
                <t t-if="documents">
                    <p style="margin: 10px 0 6px; font-weight: 700; color: #000000;">
                        Documents you may find useful:
                    </p>
                    <ul style="margin: 0 0 8px; padding-left: 18px;">
                        <t t-foreach="documents" t-as="document">
                            <li style="margin: 2px 0;">
                                <a style="color: #000000; text-decoration: underline; font-weight: 600;"
                                   t-out="document.ir_attachment_id.name"
                                   t-att-href="object.get_portal_url('/document/' + str(document.id))"
                                   t-att-target="target"/>
                            </li>
                        </t>
                    </ul>
                </t>
            </td>
        </tr>
        <tr>
            <td style="padding: 4px 40px 26px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Natural stone is a living material — availability of specific
                    slabs cannot be held indefinitely. Should you wish to secure
                    your selection, simply reply to this email and your advisor
                    will assist you at once.
                </p>
                <p style="margin: 0;">
                    Warm regards,<br/>
                    <b t-out="object.user_id.name or object.company_id.name or ''">Advisor</b><br/>
                    <span style="color: #555555;" t-out="object.company_id.name or ''">SOM Group</span>
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 16px 32px; background: #000000; text-align: center;">
                <div style="font-size: 11px; color: #cccccc; letter-spacing: .12em; text-transform: uppercase;">
                    <span t-out="object.company_id.name or 'SOM Group'">SOM Group</span>
                    <t t-if="object.company_id.phone"> · <span t-out="object.company_id.phone"/></t>
                    <t t-if="object.company_id.email"> · <span t-out="object.company_id.email"/></t>
                </div>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>
</odoo>
