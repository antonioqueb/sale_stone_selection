<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_stone_selection.StoneExpandButton" owl="1">
        <div class="stone-field-wrapper" t-on-click="handleToggle">
            <button class="stone-toggle-btn"
                    t-att-class="isSelectionLocked() ? 'stone-toggle-locked' : (state.isExpanded ? 'active' : '')"
                    t-att-title="isSelectionLocked() ? 'Primero confirma la cotización como orden de venta para seleccionar stock.' : 'Ver/ocultar lotes seleccionados'">

                <i class="fa fa-lock" t-if="isSelectionLocked()"/>
                <i class="fa fa-th-large" t-if="!isSelectionLocked() and !state.isExpanded"/>
                <i class="fa fa-chevron-up" t-if="!isSelectionLocked() and state.isExpanded"/>

                <span t-if="state.selectedCount > 0 and !state.isExpanded and !isSelectionLocked()"
                      class="stone-count-badge">
                    <t t-esc="state.selectedCount"/>
                </span>
            </button>
        </div>
    </t>
</templates>